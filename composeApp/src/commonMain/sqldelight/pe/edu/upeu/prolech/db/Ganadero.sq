-- Catálogo local de ganaderos de la ruta del chofer.
-- Se descarga de /api/mi-ruta al sincronizar para poder registrar acopios sin red.
CREATE TABLE GanaderoEntity (
    id         INTEGER NOT NULL PRIMARY KEY,
    nombre     TEXT    NOT NULL,
    dni        TEXT    NOT NULL,
    -- 1 = suspendido por faltas de calidad, 0 = activo
    suspendido INTEGER NOT NULL DEFAULT 0,
    -- Entregas que aún no puede hacer por una sanción de calidad
    bloqueado  INTEGER NOT NULL DEFAULT 0,
    -- Código del frasco si hoy le toca muestra sorpresa (null = no)
    muestra    TEXT
);

selectAllGanaderos:
SELECT *
FROM GanaderoEntity
ORDER BY nombre;

upsertGanadero:
INSERT OR REPLACE INTO GanaderoEntity VALUES ?;

deleteAllGanaderos:
DELETE FROM GanaderoEntity;
