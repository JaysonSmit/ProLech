# Copiar como ../.env (raíz del backend) y completar. NUNCA subir el .env a git.
DOMINIO=api.tu-dominio.pe

APP_NAME=ProLech
APP_ENV=production
APP_DEBUG=false
# Genera la clave con: docker compose --env-file ../.env run --rm app php artisan key:generate --show
APP_KEY=
APP_URL=https://api.tu-dominio.pe
APP_LOCALE=es
APP_TIMEZONE=America/Lima

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=prolech
DB_USERNAME=prolech
DB_PASSWORD=cambia-esta-clave-larga

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# WhatsApp (Ultramsg) — vacío = solo se registra en el log
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
# Boleta electrónica SUNAT (Nubefact) — vacío = boleta interna
NUBEFACT_URL=
NUBEFACT_TOKEN=

# Respaldos automáticos (prolech:respaldo, todos los días a las 02:00)
RESPALDO_CONSERVAR=14
# En Laragon: RESPALDO_MYSQLDUMP="C:/laragon/bin/mysql/mysql-8.0.30-winx64/bin/mysqldump.exe"
RESPALDO_MYSQLDUMP=mysqldump
