-- Migración v1 → v2: la v1 solo tenía AcopioEntity.
-- Agrega el catálogo de ganaderos, el recorrido GPS y la caché de la ruta.

CREATE TABLE IF NOT EXISTS GanaderoEntity (
    id         INTEGER NOT NULL PRIMARY KEY,
    nombre     TEXT    NOT NULL,
    dni        TEXT    NOT NULL,
    suspendido INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS PuntoGpsEntity (
    id            INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    lat           REAL    NOT NULL,
    lon           REAL    NOT NULL,
    precisionM    REAL,
    velocidadKmh  REAL,
    registradoEn  INTEGER NOT NULL,
    enviado       INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS idx_punto_registrado ON PuntoGpsEntity(registradoEn);

CREATE TABLE IF NOT EXISTS RutaCacheEntity (
    id             INTEGER NOT NULL PRIMARY KEY,
    json           TEXT    NOT NULL,
    actualizadoEn  INTEGER NOT NULL
);
